# Git branch pulled by bash ./deploy/cpa.sh upgrade on the Linux server.
CPA_DEPLOY_BRANCH=custom/main

# Local Docker image repository. A commit tag is appended automatically.
CLI_PROXY_IMAGE_REPOSITORY=cli-proxy-api

# Bind the API to localhost and publish it through Nginx or Caddy.
CPA_BIND_ADDRESS=127.0.0.1
CPA_API_PORT=8317

# Keep OAuth callback ports private. Use SSH port forwarding when logging in.
CPA_OAUTH_BIND_ADDRESS=127.0.0.1
CPA_CODEX_OAUTH_PORT=1455
CPA_CLAUDE_OAUTH_PORT=54545
CPA_ANTIGRAVITY_OAUTH_PORT=51121

# Persistent host paths, resolved from the repository root.
CPA_CONFIG_PATH=./config.yaml
CPA_AUTH_PATH=./auths
CPA_LOG_PATH=./logs
CPA_PLUGIN_PATH=./plugins

# Health check settings used after deployment and rollback.
CPA_HEALTH_URL=http://127.0.0.1:8317/healthz
CPA_HEALTH_RETRIES=30
CPA_HEALTH_INTERVAL=2
